{
  "name": "轻账单 · 个人记账",
  "short_name": "轻账单",
  "description": "本地优先的个人记账应用：记账、统计、预算、借贷、周期账单",
  "lang": "zh-CN",
  "dir": "ltr",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#f6f7fa",
  "theme_color": "#f6f7fa",
  "categories": ["finance", "productivity", "lifestyle"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "记一笔", "short_name": "记一笔", "url": "./index.html#/record", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "统计", "short_name": "统计", "url": "./index.html#/stats/month", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "日历", "short_name": "日历", "url": "./index.html#/calendar", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
